{
  "name": "@mahirhir/tracefold",
  "version": "0.1.0",
  "description": "Typed HTTP client and offline receipt verification for Tracefold. The CLI binary is gx.",
  "license": "Apache-2.0",
  "type": "commonjs",
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc -p tsconfig.json",
    "postbuild": "node scripts/copy-wasm.mjs",
    "build:wasm": "bash ../wasm-verify/build.sh",
    "pretest": "npm run build",
    "test": "node --test",
    "prepublishOnly": "npm test",
    "quickstart": "node scripts/quickstart.mjs",
    "gui-probe": "node scripts/gui_probe.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TraceFold/tracefold.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://github.com/TraceFold/tracefold#readme",
  "bugs": {
    "url": "https://github.com/TraceFold/tracefold/issues"
  },
  "keywords": [
    "gx",
    "tracefold",
    "verified-undo",
    "receipt",
    "dsse",
    "provenance",
    "audit-log",
    "mcp"
  ],
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
