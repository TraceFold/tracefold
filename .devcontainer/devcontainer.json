// Dev container for Codespaces / VS Code Remote (req/818 ATOM 1, unlocked by
// req/806 §ADOPT-NEW after the SS750 source push). Purpose: a contributor can
// open the repo in a Codespace and land on an already-built workspace instead
// of hitting the cargo-build activation wall cold.
//
// The image ships rustup; rust-toolchain.toml (channel = "1.97.1") is the
// single source of the toolchain pin -- rustup resolves it on first cargo
// invocation, so nothing here re-declares a version that could drift.
//
// NOTE (req/818 F1): as of 2026-08-25 this file is staged for the public sync
// set but NOT yet pushed to TraceFold/tracefold -- the live public tree
// declares 5 workspace members it does not carry (probes/doubt, gx-adapter-
// postgres, gx-adapter-mysql, gx-mcp-wire, gx-confine), so `cargo build
// --workspace` fails at workspace load on a public clone. Ship this file
// publicly only after that manifest repair lands.
{
  "name": "tracefold",
  "image": "mcr.microsoft.com/devcontainers/rust:1",
  "postCreateCommand": "cargo build --workspace",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer"
      ]
    }
  }
}
